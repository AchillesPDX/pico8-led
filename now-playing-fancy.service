[Unit]
Description=Spotify Now Playing poller (fancy - with track_state.json for overlay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jared
ExecStart=/usr/bin/python3 /home/jared/pico8-led/now_playing_fancy.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
