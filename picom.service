[Unit]
Description=picom compositor for pico8-led overlay transparency
After=network-online.target pico8-led.service
Requires=pico8-led.service

[Service]
Type=simple
User=jared
Environment=DISPLAY=:3.0
ExecStart=/usr/bin/picom --config /home/jared/pico8-led/picom.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
